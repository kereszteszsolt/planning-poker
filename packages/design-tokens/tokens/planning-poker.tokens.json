{
  "Global": {
    "$description": "Raw, product-approved visual values.",
    "color": {
      "base": {
        "blue": {
          "50": { "$type": "color", "$value": "#eff6ff" },
          "100": { "$type": "color", "$value": "#dbeafe" },
          "600": { "$type": "color", "$value": "#2563eb" },
          "700": { "$type": "color", "$value": "#1d4ed8" },
          "800": { "$type": "color", "$value": "#1e40af" }
        },
        "slate": {
          "50": { "$type": "color", "$value": "#f8fafc" },
          "100": { "$type": "color", "$value": "#f1f5f9" },
          "200": { "$type": "color", "$value": "#e2e8f0" },
          "500": { "$type": "color", "$value": "#64748b" },
          "600": { "$type": "color", "$value": "#475569" },
          "700": { "$type": "color", "$value": "#334155" },
          "900": { "$type": "color", "$value": "#0f172a" }
        },
        "green": {
          "50": { "$type": "color", "$value": "#f0fdf4" },
          "700": { "$type": "color", "$value": "#15803d" },
          "800": { "$type": "color", "$value": "#166534" }
        },
        "amber": {
          "50": { "$type": "color", "$value": "#fffbeb" },
          "700": { "$type": "color", "$value": "#b45309" },
          "800": { "$type": "color", "$value": "#92400e" }
        },
        "red": {
          "50": { "$type": "color", "$value": "#fef2f2" },
          "700": { "$type": "color", "$value": "#b91c1c" },
          "800": { "$type": "color", "$value": "#991b1b" }
        },
        "white": { "$type": "color", "$value": "#ffffff" }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
        }
      },
      "size": {
        "sm": {
          "$type": "dimension",
          "$value": { "value": 0.875, "unit": "rem" }
        },
        "body": {
          "$type": "dimension",
          "$value": { "value": 1, "unit": "rem" }
        },
        "title": {
          "$type": "dimension",
          "$value": { "value": 1.5, "unit": "rem" }
        }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": 400 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold": { "$type": "fontWeight", "$value": 700 }
      }
    },
    "space": {
      "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
      "2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
      "4": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
      "8": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } }
    },
    "size": {
      "touch": {
        "$type": "dimension",
        "$value": { "value": 44, "unit": "px" }
      },
      "content": {
        "$type": "dimension",
        "$value": { "value": 72, "unit": "rem" }
      },
      "form": { "$type": "dimension", "$value": { "value": 36, "unit": "rem" } }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": { "value": 0.375, "unit": "rem" }
      },
      "md": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "lg": {
        "$type": "dimension",
        "$value": { "value": 0.75, "unit": "rem" }
      },
      "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
    },
    "border": {
      "thin": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "strong": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
    },
    "shadow": {
      "panel": {
        "$type": "shadow",
        "$value": {
          "color": "#0f172a14",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 10, "unit": "px" },
          "blur": { "value": 30, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } }
    }
  },
  "Semantic": {
    "$description": "Purpose-based application decisions.",
    "color": {
      "background": {
        "page": { "$type": "color", "$value": "{color.base.slate.50}" },
        "surface": { "$type": "color", "$value": "{color.base.white}" },
        "subtle": { "$type": "color", "$value": "{color.base.slate.100}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.base.slate.900}" },
        "secondary": { "$type": "color", "$value": "{color.base.slate.600}" },
        "inverse": { "$type": "color", "$value": "{color.base.white}" },
        "link": { "$type": "color", "$value": "{color.base.blue.700}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.base.slate.200}" },
        "strong": { "$type": "color", "$value": "{color.base.slate.500}" },
        "focus": { "$type": "color", "$value": "{color.base.blue.700}" }
      },
      "action": {
        "primary": { "$type": "color", "$value": "{color.base.blue.700}" },
        "primaryHover": { "$type": "color", "$value": "{color.base.blue.800}" },
        "success": { "$type": "color", "$value": "{color.base.green.700}" },
        "successHover": {
          "$type": "color",
          "$value": "{color.base.green.800}"
        },
        "warning": { "$type": "color", "$value": "{color.base.amber.700}" },
        "warningHover": {
          "$type": "color",
          "$value": "{color.base.amber.800}"
        },
        "danger": { "$type": "color", "$value": "{color.base.red.700}" },
        "dangerHover": { "$type": "color", "$value": "{color.base.red.800}" }
      },
      "status": {
        "successSurface": {
          "$type": "color",
          "$value": "{color.base.green.50}"
        },
        "warningSurface": {
          "$type": "color",
          "$value": "{color.base.amber.50}"
        },
        "dangerSurface": { "$type": "color", "$value": "{color.base.red.50}" },
        "dangerText": { "$type": "color", "$value": "{color.base.red.800}" }
      }
    },
    "focus": {
      "width": { "$type": "dimension", "$value": "{border.strong}" },
      "offset": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
    }
  },
  "Components": {
    "$description": "Only component decisions used by the current product.",
    "component": {
      "panel": {
        "background": {
          "$type": "color",
          "$value": "{color.background.surface}"
        },
        "radius": { "$type": "dimension", "$value": "{radius.lg}" },
        "shadow": { "$type": "shadow", "$value": "{shadow.panel}" }
      },
      "button": {
        "radius": { "$type": "dimension", "$value": "{radius.md}" },
        "minHeight": { "$type": "dimension", "$value": "{size.touch}" }
      },
      "voteCard": {
        "radius": { "$type": "dimension", "$value": "{radius.md}" },
        "minSize": { "$type": "dimension", "$value": "{size.touch}" },
        "default": { "$type": "color", "$value": "{color.action.primary}" },
        "selected": { "$type": "color", "$value": "{color.base.blue.800}" },
        "hidden": { "$type": "color", "$value": "{color.base.slate.600}" }
      }
    }
  }
}
